msgctxt "0509ab2360014d4292e637062af127eb"
msgid "། ཐམས་ཅད་ འབྱུང་ ཞིང་ འཁྲུལ་སྣང་ ང་ ཡི་ སེམས །"
msgstr "Kaikki nousevat hämmentyneet ilmentymät ovat mieleni."

msgctxt "6ab4e0da60fa45009d7334a0fa18c030"
msgid "། ཐམས་ཅད་ གནས་པ་ འཁྲུལ་སྣང་ ང་ ཡི་ ཐུགས །"
msgstr "Kaikki olevat hämmentyneet ilmentymät ovat mieleni."

msgctxt "11919e30dac04a579338084e0ccefb32"
msgid "། ཐམས་ཅད་ སྣང་བ་ འཁྲུལ་སྣང་ ང་ ཡི་ སྐུ །"
msgstr "Kaikki ilmenevät hämmentyneet ilmentymät ovat kehoni. "

msgctxt "7c01905e0fd045ceab8b20c873122bf4"
msgid "། ཐམས་ཅད་ འགག་པ་ འཁྲུལ་སྣང་ ང་ ཡི་ གསུང༌ །"
msgstr "Kaikki päättyvät hämmentyneet ilmentymät ovat puheeni."

msgctxt "a364f7446b93469ea2101efdeefae475"
msgid "། མཐོང་བ་ མ་ འགག་␣ས་ ང་ ཡི་ གཟུགས་ ལྟར་ སྣང༌ །"
msgstr "Lakkaamaton näkeminen näkyy kehonani."

msgctxt "2935a41a941448b4b0bf353aad97a000"
msgid "། ཐོས་པ་ མ་ འགག་␣ས་ ང་ ཡི་ སྒྲ་ ལྟར་ གྲག"
msgstr "Lakkaamaton kuuleminen kuuluu puheenani."

msgctxt "6467b08c91cc4b22888f86e510880641"
msgid "། སྣོམ་བྱེད་ མ་ འགག་␣ས་ ང་ ཡི་ དྲི་ ལྟར་ ཚོར །"
msgstr "Lakkaamaton haistaminen tuoksuu tuoksunani."

msgctxt "3fb55574b8054874995e3c6845f7029f"
msgid "། མྱོང་ བྱེད་ མ་ འགག་␣ས་ ང་ ཡི་ རོ་ ལྟར་ བདའ །"
msgstr "Lakkaamaton tunteminen on vikkelä kuin mieleni."

msgctxt "db2815b693c04c7e90530ca677be007d"
msgid "། ཚོར་ བྱེད་ མ་ འགག་␣ས་ ང་ ཡི་ ཡིད་ ལྟར་ མགྱོགས །"
msgstr "Salaiset häiriötekijät ovat maagisia emanaatioitani. "

msgctxt "dae4e227745241d6a70e915b3dd7395e"
msgid "། གསང་བ་␣འི་ ཉོན་མོངས་ ང་ ཡི་ ཆོ་འཕྲུལ་ ཏེ །"
msgstr ""

msgctxt "4cd8488a16094a1cbd7c5831ca9a8238"
msgid "། སངས་རྒྱས་ སེམས་ཅན་ ང་ ཡི་ དུར་ས་ ཡིན །"
msgstr ""

msgctxt "6f779a323e2c442aacd3bfd262f45605"
msgid "། ཀུན་ བྱེད་ ང་ ནི་ སྣང་བ་ རང་ གསལ་ ཆེ །"
msgstr ""
